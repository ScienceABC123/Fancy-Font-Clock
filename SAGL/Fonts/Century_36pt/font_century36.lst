 325              	
 326              	/*******************************************************************************
 327              	*
 328              	* Bit mapped glyph data (address offsets)
 329              	* 0: ASCII character
 330              	* 4: cell pixel width (may be variable for proportional spacing)
 331              	* 8: cell pixel height (must be constant for all characters in a font)
 332              	* 12: glyph pixel width
 333              	* 16: glyph pixel height
 334              	* 20: blank horizontal pixels before glyph
 335              	* 24: blank horizontal pixels after glyph
 336              	* 28: blank horizontal lines before glyph
 337              	* 32: blank horizontal lines after glyph
 338              	* 36: bit mapped glyph
ARM GAS  font_century36.s 			page 7


 339              	*
 340              	* cell pixel width = blank horizontal pixels before glyph + glyph pixel width + blank horizontal pi
 341              	*
 342              	* cell pixel height = blank horizontal lines before glyph + glyph pixel height + blank horizontal l
 343              	*
 344              	*******************************************************************************/
