 324              	
 325              	/*******************************************************************************
 326              	*
 327              	* Bit mapped glyph data (address offsets)
 328              	* 0: ASCII character
 329              	* 4: cell pixel width (may be variable for proportional spacing)
 330              	* 8: cell pixel height (must be constant for all characters in a font)
 331              	* 12: glyph pixel width
 332              	* 16: glyph pixel height
 333              	* 20: blank horizontal pixels before glyph
 334              	* 24: blank horizontal pixels after glyph
 335              	* 28: blank horizontal lines before glyph
 336              	* 32: blank horizontal lines after glyph
 337              	* 36: bit mapped glyph
 338              	*
ARM GAS  font_arial31.s 			page 7


 339              	* cell pixel width = blank horizontal pixels before glyph + glyph pixel width + blank horizontal pi
 340              	*
 341              	* cell pixel height = blank horizontal lines before glyph + glyph pixel height + blank horizontal l
 342              	*
 343              	*******************************************************************************/
 344              	
 345              	SPACE:
 346 0428 20000000 			.word	' 			// ASCII " " character
 347 042c 12000000 			.word	18			// cell pixel width
 348 0430 26000000 			.word	CELLHGHT		// cell pixel height
 349 0434 00000000 			.word	0			// glyph pixel width
 350 0438 00000000 			.word	0			// glyph pixel height
 351 043c 00000000 			.word	0			// blank horizontal pixels before glyph
 352 0440 00000000 			.word	0			// blank horizontal pixels after glyph
 353 0444 26000000 			.word	CELLHGHT		// blank horizontal lines before glyph
 354 0448 00000000 			.word	0			// blank horizontal lines after glyph
 355              							// no bit mapped glyph for <space>
 356              	/*
 357              	EXCLAMATION_MARK:
 358              			.word	'!			// ASCII "!" character
 359              			.word				// cell pixel width
 360              			.word	CELLHGHT		// cell pixel height
 361              			.word				// glyph pixel width
 362              			.word				// glyph pixel height
 363              			.word				// blank horizontal pixels before glyph
 364              			.word				// blank horizontal pixels after glyph
 365              			.word				// blank horizontal lines before glyph
 366              			.word				// blank horizontal lines after glyph
 367              							// bit mapped glyph
 368              	
 369              	QUOTE_MARK:
 370              			.word	'"			// ASCII """ character
 371              			.word				// cell pixel width
 372              			.word	CELLHGHT		// cell pixel height
 373              			.word				// glyph pixel width
 374              			.word				// glyph pixel height
 375              			.word				// blank horizontal pixels before glyph
 376              			.word				// blank horizontal pixels after glyph
 377              			.word				// blank horizontal lines before glyph
 378              			.word				// blank horizontal lines after glyph
 379              							// bit mapped glyph
 380              	
 381              	NUMBER_SIGN:
 382              			.word	'#			// ASCII "#" character
 383              			.word				// cell pixel width
 384              			.word	CELLHGHT		// cell pixel height
 385              			.word				// glyph pixel width
 386              			.word				// glyph pixel height
 387              			.word				// blank horizontal pixels before glyph
 388              			.word				// blank horizontal pixels after glyph
 389              			.word				// blank horizontal lines before glyph
 390              			.word				// blank horizontal lines after glyph
 391              							// bit mapped glyph
 392              	
 393              	DOLLAR_SIGN:
 394              			.word	'$			// ASCII "$" character
 395              			.word				// cell pixel width
ARM GAS  font_arial31.s 			page 8


 396              			.word	CELLHGHT		// cell pixel height
 397              			.word				// glyph pixel width
 398              			.word				// glyph pixel height
 399              			.word				// blank horizontal pixels before glyph
 400              			.word				// blank horizontal pixels after glyph
 401              			.word				// blank horizontal lines before glyph
 402              			.word				// blank horizontal lines after glyph
 403              							// bit mapped glyph
