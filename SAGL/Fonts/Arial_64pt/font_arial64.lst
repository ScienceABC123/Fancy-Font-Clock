 324              	
 325              	/*******************************************************************************
 326              	*
 327              	* Bit mapped glyph data (address offsets)
 328              	* 0: ASCII character
 329              	* 4: cell pixel width (may be variable for proportional spacing)
 330              	* 8: cell pixel height (must be constant for all characters in a font)
 331              	* 12: glyph pixel width
 332              	* 16: glyph pixel height
 333              	* 20: blank horizontal pixels before glyph
 334              	* 24: blank horizontal pixels after glyph
 335              	* 28: blank horizontal lines before glyph
 336              	* 32: blank horizontal lines after glyph
 337              	* 36: bit mapped glyph
 338              	*
ARM GAS  font_arial64.s 			page 7


 339              	* cell pixel width = blank horizontal pixels before glyph + glyph pixel width + blank horizontal pi
 340              	*
 341              	* cell pixel height = blank horizontal lines before glyph + glyph pixel height + blank horizontal l
 342              	*
 343              	*******************************************************************************/
 344              	
