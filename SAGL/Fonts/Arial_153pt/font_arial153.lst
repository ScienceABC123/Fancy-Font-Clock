 324              	
 325              	/*******************************************************************************
 326              	*
 327              	* Bit mapped glyph data (address offsets)
 328              	* 0: ASCII character
 329              	* 4: cell pixel width (may be variable for proportional spacing)
 330              	* 8: cell pixel height (must be constant for all characters in a font)
 331              	* 12: glyph pixel width
 332              	* 16: glyph pixel height
 333              	* 20: blank horizontal pixels before glyph
 334              	* 24: blank horizontal pixels after glyph
 335              	* 28: blank horizontal lines before glyph
 336              	* 32: blank horizontal lines after glyph
 337              	* 36: bit mapped glyph
 338              	*
ARM GAS  font_arial153.s 			page 7


 339              	* cell pixel width = blank horizontal pixels before glyph + glyph pixel width + blank horizontal pi
 340              	*
 341              	* cell pixel height = blank horizontal lines before glyph + glyph pixel height + blank horizontal l
 342              	*
 343              	*******************************************************************************/
 344              	
 345              	SPACE:
 346 0428 20000000 			.word	' 			// ASCII " " character
 347              			.word				// cell pixel width
 348 042c BB000000 			.word	CELLHGHT		// cell pixel height
 349              			.word				// glyph pixel width
 350              			.word				// glyph pixel height
 351              			.word				// blank horizontal pixels before glyph
 352              			.word				// blank horizontal pixels after glyph
 353 0430 BB000000 			.word	CELLHGHT		// blank horizontal lines before glyph
 354              			.word				// blank horizontal lines after glyph
 355              							// no bit mapped glyph for <space>
 356              	
 357              	EXCLAMATION_MARK:
 358 0434 21000000 			.word	'!			// ASCII "!" character
 359              			.word				// cell pixel width
 360 0438 BB000000 			.word	CELLHGHT		// cell pixel height
 361              			.word				// glyph pixel width
 362              			.word				// glyph pixel height
 363              			.word				// blank horizontal pixels before glyph
 364              			.word				// blank horizontal pixels after glyph
 365              			.word				// blank horizontal lines before glyph
 366              			.word				// blank horizontal lines after glyph
 367              							// bit mapped glyph
 368              	
